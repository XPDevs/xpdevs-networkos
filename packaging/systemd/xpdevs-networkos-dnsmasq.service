[Unit]
Description=XPDevs NetworkOS DHCP server (dnsmasq)
Documentation=https://xpdevs.github.io/
After=xpdevs-networkos-net.service xpdevs-networkos-ap.service
Requires=xpdevs-networkos-net.service
Wants=xpdevs-networkos-ap.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/xpdevs-networkos/generated/dnsmasq.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/xpdevs-networkos/generated/dnsmasq.conf
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
# dnsmasq binds UDP 67 only; DNS stays with Pi-hole.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
