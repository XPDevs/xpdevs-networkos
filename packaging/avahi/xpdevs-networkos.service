<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the XPDevs NetworkOS dashboard over mDNS. -->
<service-group>
  <name replace-wildcards="yes">XPDevs NetworkOS on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
    <txt-record>product=XPDevs NetworkOS</txt-record>
  </service>
</service-group>
